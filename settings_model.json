{
    "result_path": {
        "情報系": {
            "base": "./result_情報系/filter_base",
            "adv": "./result_情報系/filter_adv",
            "comet": "./result_情報系/comet"
        },
        "化学系": {
            "base": "./result_化学系/filter_base",
            "adv": "./result_化学系/filter_adv",
            "comet": "./result_化学系/comet"
        },
        "atomic": "./result_atomic"
    },

    "params_base": {
        "model_name": "tohoku-nlp/bert-base-japanese",
        "learning_rate": 2e-5,
        "weight_decay": 0.01,
        "early_stopping": {
            "flag": true,
            "patience": 5
        },
        "epochs": 20,
        "batch_size": 32,
        "eval_steps": 1
    },

    "params_adv": {
        "model_name": "tohoku-nlp/bert-base-japanese",
        "iterations": 200,
        "switch": {
            "flag": true,
            "end_iters": 150,
            "start_ratio": 0.05
        },
        "selector": {
            "learning_rate": 2e-5,
            "weight_decay": 0.01,
            "steps": 3,
            "batch_size": 32,
            "select_num": 500
        },
        "discriminator": {
            "learning_rate": 2e-5,
            "weight_decay": 0.01,
            "hinge_loss": {
                "start_iters": 125,
                "end_iters": 175,
                "max_weight": 0.3
            },
            "steps": 4,
            "batch_size": 32,
            "select_num": 500,
            "sample_from_silver": {
                "start_thresh": 0.2,
                "end_thresh": 0.7,
                "end_iters": 150,
                "steps_random": 2
            }
        }
    },

    "params_comet": {
        "tr_silver_temperature": 1.0,
        "model_name": "nlp-waseda/comet-v2-gpt2-small-japanese",
        "per_device_train_batch_size": 16,
        "per_device_eval_batch_size": 16,
        "learning_rate": 2e-5,
        "weight_decay": 0.01,
        "num_train_epochs": 3
    }
}