{
    "result_path": {
        "情報系": "./result_情報系",
        "化学系": "./result_化学系"
    },

    "params_base": {
        "model_name": "tohoku-nlp/bert-base-japanese",
        "learning_rate": 5e-6,
        "weight_decay": 0.01,
        "early_stopping": {
            "flag": true,
            "patience": 5
        },
        "epochs": 20,
        "batch_size": 32,
        "eval_steps": 1,
        "augmentation_patent_ratio": 0.2
    },

    "params_adv": {
        "model_name": "tohoku-nlp/bert-base-japanese",
        "iterations": 200,
        "augmentation": {
            "flag": true,
            "end_iters": 80,
            "start_ratio": 0.2
        },
        "selector": {
            "learning_rate": 5e-6,
            "weight_decay": 0.01,
            "steps": 3,
            "batch_size": 32,
            "select_num": 500
        },
        "discriminator": {
            "learning_rate": 5e-6,
            "weight_decay": 0.01,
            "hinge_loss": {
                "start_iters": 100,
                "end_iters": 160,
                "max_weight": 0.3
            },
            "steps": 4,
            "batch_size": 32,
            "select_num": 500,
            "sample_from_silver": {
                "start_thresh": 0.2,
                "end_thresh": 0.7,
                "end_iters": 160,
                "steps_random": 2
            }
        }
    },

    "params_comet": {
        "tr_silver_temperature": 1.0,
        "model_name": "nlp-waseda/comet-v2-gpt2-small-japanese",
        "per_device_train_batch_size": 16,
        "per_device_eval_batch_size": 16,
        "learning_rate": 2e-5,
        "weight_decay": 0.01,
        "num_train_epochs": 10
    }
}